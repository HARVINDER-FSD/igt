{
  "name": "digital-marketing-project",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"magenta,cyan\" \"npm run server\" \"npm run client\"",
    "client": "npm run dev --prefix client",
    "client:build": "npm run build --prefix client",
    "server": "node server/server.js",
    "server:dev": "npm run dev --prefix server",
    "build": "npm run build --prefix client",
    "install:all": "npm install --prefix client && npm install --prefix server"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
